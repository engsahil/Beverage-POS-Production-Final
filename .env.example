# The only environment variable this app needs.
#
# Local development: your local PostgreSQL connection string, e.g.
#   DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/beverage_pos
#
# Neon (recommended for production): use the POOLED connection string
# from the Neon console. It looks like:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DBNAME?sslmode=require
#
# Use the direct (non-pooled) URL when running db:migrate / db:seed.

DATABASE_URL=
